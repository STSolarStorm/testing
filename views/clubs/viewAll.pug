extends ../layout

block content
    include ../mixins/clubCard
    .main-content

        h1 Welcome to Edison's Club Directory!
        p Explore all the student organizations on campus.

        .search-bar
            form.form-search(action="/search", method="GET")
                div.form-search-options
                    input(type="text", name="q", placeholder="Search clubs...", value=searchQuery)
                    label(for="random") Random
                    input(type="checkbox" name="random" id="random" checked=searchRandom)
                button.button-search(type="submit") Search


        .clubs-container
            each club in clubs
                +clubCard(club)

    // Modal Overlay (hidden by default)
    #modal-overlay.modal-overlay

    // Modal (hidden by default)
    #club-modal.modal
        .modal-banner
            img#modal-banner(src='/images/placeholder.jpg', alt='Club Banner', onerror="this.src='/images/placeholder.jpg';")
        .modal-content
            span#close-btn &times;
            h2#modal-name Club Name
            p#modal-bigdesc Description
            p#modal-location Location:
            p#modal-meeting Meeting:
            p#modal-commitment Commitment:
            p#modal-advisor Advisor:
            p#modal-officers Officers:
            a#modal-more(href="/clubs/") More Info →

    // Pass club data to JavaScript (ONLY ONCE, at the bottom)
    script.
        window.clubsData = !{JSON.stringify(clubs).replace(/</g, '\\u003c')};