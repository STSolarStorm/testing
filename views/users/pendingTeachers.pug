extends ../layout

block content
    .main-content
        h1 Pending Teacher Registrations
        p Review and approve educator access requests below.

        if teachers.length > 0
            table.admin-table
                thead
                    tr
                        th Name
                        th Email
                        th Actions
                tbody
                    each teacher in teachers
                        tr
                            td= `${teacher.ulastname}, ${teacher.ufirstname}`
                            td= teacher.email
                            td
                                .action-buttons
                                    form(action=`/admin/approve/${teacher.id}` method="POST" style="display:inline;")
                                        button.button-submit(type="submit") Approve
                                    form(action=`/admin/deny/${teacher.id}` method="POST" style="display:inline; margin-left: 10px;")
                                        button.button-cancel(type="submit" onclick="return confirm('Are you sure you want to deny this registration?');") Deny
        else
            .no-pending-box
                p No pending teacher registrations.